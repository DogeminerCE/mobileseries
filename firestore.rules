rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Drop spots collection — the core of the interactive map
    match /dropSpots/{spotId} {
      // Anyone can read all drop spots (communal map view)
      allow read: if true;
      
      // Only authenticated users can create drop spots
      // They must set their own UID as the epicAccountId
      allow create: if request.auth != null 
                    && request.resource.data.epicAccountId == request.auth.uid
                    && request.resource.data.playerName is string
                    && request.resource.data.region is string
                    && request.resource.data.x is number
                    && request.resource.data.y is number
                    && request.resource.data.x >= 0 && request.resource.data.x <= 100
                    && request.resource.data.y >= 0 && request.resource.data.y <= 100;
      
      // Only the owner can update their own drop spot
      allow update: if request.auth != null
                    && resource.data.epicAccountId == request.auth.uid
                    && request.resource.data.epicAccountId == request.auth.uid;
      
      // Only the owner can delete their own drop spot
      allow delete: if request.auth != null
                    && resource.data.epicAccountId == request.auth.uid;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
