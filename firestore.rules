rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin's Epic display name is "Blitzʼd Babylion", whose apostrophe is
    // U+02BC rather than ASCII. Comparing the raw string would be one stray glyph
    // away from silently losing admin, so strip to alphanumerics before matching.
    function isAdminName(name) {
      return name != null && name.lower().replace('[^a-z0-9]', '') == 'blitzdbabylion';
    }

    function isAdmin() {
      return isAdminName(request.auth.token.epic_display_name)
             || isAdminName(request.auth.token.name);
    }

    match /dropSpots/{spotId} {
      // Anyone can read drop spots
      allow read: if true;
      
      // Authenticated users can create their own drop spots
      allow create: if request.auth != null 
                    && request.resource.data.epicAccountId == request.auth.uid
                    && request.resource.data.playerName is string
                    && request.resource.data.region is string
                    && request.resource.data.mapSession is string
                    && request.resource.data.x is number
                    && request.resource.data.y is number
                    && request.resource.data.x >= 0 && request.resource.data.x <= 100
                    && request.resource.data.y >= 0 && request.resource.data.y <= 100
                    && request.resource.data.color is string
                    && request.resource.data.path is list;
      
      // Users can only update their own spots
      allow update: if request.auth != null
                    && resource.data.epicAccountId == request.auth.uid
                    && request.resource.data.epicAccountId == request.auth.uid
                    && request.resource.data.mapSession == resource.data.mapSession;
      
      // Users can only delete their own spots, except admin
      allow delete: if request.auth != null
                    && (resource.data.epicAccountId == request.auth.uid || isAdmin());
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
